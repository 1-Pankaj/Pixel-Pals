# Set default behavior to automatically normalize text line endings to LF
* text=auto eol=lf

# Explicit text files
*.js text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Explicit binary files (never normalize or modify)
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.woff2 binary
*.woff binary
*.ttf binary
*.eot binary
