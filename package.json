{
  "name": "pixel-pals",
  "productName": "Pixel Pals",
  "version": "2.0.0",
  "description": "Cute pixel pets that live on your Windows desktop. A cat, a penguin, and an axolotl whose eyes follow your cursor.",
  "private": true,
  "main": "src/main/main.js",
  "author": "Pankaj (https://github.com/1-Pankaj)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/1-Pankaj/Pixel-Pals.git"
  },
  "bugs": {
    "url": "https://github.com/1-Pankaj/Pixel-Pals/issues"
  },
  "homepage": "https://1-pankaj.github.io/Pixel-Pals/",
  "keywords": [
    "desktop-pet",
    "pixel-art",
    "virtual-pet",
    "electron",
    "tamagotchi",
    "cozy",
    "pixel-pets",
    "windows-desktop"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "desktop": "electron .",
    "start": "electron .",
    "test": "node scripts/selftest.js",
    "preview": "node scripts/preview.js",
    "icons": "node scripts/make-icons.js",
    "dist": "npm run icons && electron-builder --win --publish never",
    "dist:dir": "npm run icons && electron-builder --win --dir --publish never",
    "dist:portable": "npm run icons && electron-builder --win portable --publish never",
    "test:website": "python website/test_website.py"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.pixelpals.app",
    "productName": "Pixel Pals",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "main.js"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pixel Pals",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "${productName}-portable-${version}.${ext}"
    }
  }
}
